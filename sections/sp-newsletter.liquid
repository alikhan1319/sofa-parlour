{%- comment -%}
  ============================================================
  Newsletter
  ============================================================

  A raised card on the espresso ground: the pitch on the left, the form on
  the right, with the field and its button sharing one continuous pill.

  SHOPIFY PLUMBING — do not rename these, the customer endpoint reads them:
    contact[email]          the address
    contact[tags]           tagged "newsletter" so the merchant can segment
    name="commit"           the submit button Shopify expects
    form.posted_successfully? / form.errors   round-trip state

  The form posts and the page reloads — there is no AJAX here on purpose.
  A subscription is a real record on the shop, and Shopify's own round trip
  is what confirms it was written. A fake inline "thanks" that fires before
  the server answers would be lying about whether anything was saved.

  Every visible string is a setting, so nothing here promises a frequency,
  a discount or a swatch on the merchant's behalf.
  ============================================================
{%- endcomment -%}

{{ 'sp-newsletter.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign notes = section.blocks | where: 'type', 'note'
-%}

<section
  class="sp-nl sp-nl--{{ s.scheme }}{% if s.image != blank %} sp-nl--has-image{% endif %}"
  style="--sp-nl-pad-t: {{ s.padding_top }}px; --sp-nl-pad-b: {{ s.padding_bottom }}px; --sp-nl-veil: {{ s.overlay }}%;"
  data-sp-reveal
>
  <div class="sp-nl__inner">
    <div class="sp-nl__card">
      {%- if s.image != blank -%}
        <div class="sp-nl__bg" aria-hidden="true">
          {%- assign bg_alt = '' -%}
          {{
            s.image
            | image_url: width: 2000
            | image_tag:
              class: 'sp-nl__bg-img',
              widths: '600, 900, 1200, 1600, 2000',
              sizes: '(min-width: 990px) 92vw, 100vw',
              loading: 'lazy',
              alt: bg_alt
          }}
        </div>
      {%- endif -%}

      <div class="sp-nl__grid">
        <div class="sp-nl__pitch">
          {%- if s.eyebrow != blank -%}
            <p class="sp-nl__eyebrow">{{ s.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if s.heading != blank -%}
            <h2 class="sp-nl__heading">{{ s.heading | escape }}</h2>
          {%- endif -%}

          {%- if s.text != blank -%}
            <p class="sp-nl__text">{{ s.text | escape }}</p>
          {%- endif -%}
        </div>

        <div class="sp-nl__form-col">
          {%- form 'customer', class: 'sp-nl__form', novalidate: 'novalidate' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.posted_successfully? -%}
              {%- comment -%}
                The success state replaces the field entirely. Leaving an
                empty box next to a confirmation invites a second submit of
                the same address.
              {%- endcomment -%}
              <p class="sp-nl__done" id="Newsletter-success--{{ section.id }}" role="status" tabindex="-1">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 12.5 9.5 18 20 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ s.success_text | default: 'Thanks for subscribing' | escape }}</span>
              </p>
            {%- else -%}
              <div class="sp-nl__rail{% if form.errors %} has-error{% endif %}">
                <label class="visually-hidden" for="Newsletter--{{ section.id }}">
                  {{- s.placeholder | default: 'Email address' | escape -}}
                </label>

                <input
                  id="Newsletter--{{ section.id }}"
                  class="sp-nl__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ s.placeholder | default: 'Email address' | escape }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  spellcheck="false"
                  aria-required="true"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="Newsletter-error--{{ section.id }}"
                  {% endif %}
                  required
                >

                <button type="submit" name="commit" class="sp-nl__submit">
                  <span>{{ s.button_label | default: 'Subscribe' | escape }}</span>
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>

              {%- if form.errors -%}
                <p class="sp-nl__error" id="Newsletter-error--{{ section.id }}" role="alert">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M12 7.5v5.5M12 16.2v.3" stroke-linecap="round"/>
                  </svg>
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}: </span>
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}

              {%- if s.consent != blank -%}
                <p class="sp-nl__consent">{{ s.consent }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}

          {%- if notes.size > 0 -%}
            <ul class="sp-nl__notes" role="list">
              {%- for block in notes -%}
                {%- if block.settings.text != blank -%}
                  <li class="sp-nl__note" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New pieces, before the showroom sees them" },
    { "type": "text", "id": "text", "label": "Text", "default": "Occasional letters about what we are making, what we are learning, and the odd thing we get wrong." },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks — you are on the list." },
    { "type": "richtext", "id": "consent", "label": "Small print", "info": "Say what you will send and how to stop. Required in the UK and EU." , "default": "<p>We only write about our own work. Unsubscribe from any letter.</p>" },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Sits behind the card, under a veil." },
    { "type": "range", "id": "overlay", "label": "Veil", "min": 40, "max": 95, "step": 5, "unit": "%", "default": 80 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "ground", "label": "Espresso" },
        { "value": "raised", "label": "Raised" }
      ],
      "default": "ground"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Reassurance",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "About twice a month" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "blocks": [
        { "type": "note", "settings": { "text": "About twice a month" } },
        { "type": "note", "settings": { "text": "No third parties" } }
      ]
    }
  ]
}
{% endschema %}
