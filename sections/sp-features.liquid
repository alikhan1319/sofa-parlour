{%- comment -%}
  ============================================================
  Features — a row of reasons
  ============================================================

  Icon, title, one line. Four across on a wide screen, wrapping down to two
  and then one.

  Every word is a block the merchant writes. The theme states no guarantee,
  quotes no delivery time and promises no returns window on the shop's
  behalf — on a furniture page those are contractual claims, not copy.
  ============================================================
{%- endcomment -%}

{{ 'sp-blocks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'feature'
-%}

{%- if items.size > 0 -%}
  <section
    class="sp-fx sp-fx--{{ s.scheme }}"
    style="--sp-fx-pad-t: {{ s.padding_top }}px; --sp-fx-pad-b: {{ s.padding_bottom }}px;"
    data-sp-reveal
  >
    <div class="sp-fx__inner">
      {%- if s.heading != blank -%}
        <h2 class="sp-fx__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}

      <ul class="sp-fx__grid" role="list">
        {%- for block in items -%}
          <li class="sp-fx__item" {{ block.shopify_attributes }}>
            <span class="sp-fx__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3 5 6v6c0 4.4 3 7.6 7 9 4-1.4 7-4.6 7-9V6l-7-3Z" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'return' -%}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 9h11a5 5 0 0 1 0 10H8" stroke-linecap="round" stroke-linejoin="round"/><path d="m8 5-4 4 4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- when 'van' -%}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h10v10H3zM13 9h4l3 3v4h-7z" stroke-linejoin="round"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
                {%- when 'card' -%}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18" stroke-linecap="round"/></svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 4c0 9-5 14-12 14H5c0-9 5-14 12-14Z" stroke-linejoin="round"/><path d="M5 20c2-5 5-8 9-10" stroke-linecap="round"/></svg>
                {%- when 'swatch' -%}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/></svg>
                {%- when 'tools' -%}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 6a4 4 0 0 1 5.5 5.2L21 13l-2 2-1.8-1.5A4 4 0 0 1 12 8l2-2Z" stroke-linejoin="round"/><path d="m11 11-7 7 2 2 7-7" stroke-linejoin="round"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endcase -%}
            </span>

            <div class="sp-fx__copy">
              {%- if block.settings.title != blank -%}
                <h3 class="sp-fx__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="sp-fx__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Features",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "ground", "label": "White" },
        { "value": "raised", "label": "Warm off-white" }
      ],
      "default": "raised"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Guarantee" },
            { "value": "return", "label": "Returns" },
            { "value": "van", "label": "Delivery" },
            { "value": "card", "label": "Payment" },
            { "value": "leaf", "label": "Materials" },
            { "value": "swatch", "label": "Swatches" },
            { "value": "tools", "label": "Made by hand" },
            { "value": "check", "label": "Check" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "10-year frame guarantee" },
        { "type": "text", "id": "text", "label": "Text", "default": "On every frame we build." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shield", "title": "10-year frame guarantee", "text": "On every frame we build." } },
        { "type": "feature", "settings": { "icon": "van", "title": "Delivered by our own team", "text": "Into the room of your choice." } },
        { "type": "feature", "settings": { "icon": "return", "title": "14-day returns", "text": "If it is not right, it goes back." } },
        { "type": "feature", "settings": { "icon": "swatch", "title": "Free fabric swatches", "text": "Order before you decide." } }
      ]
    }
  ]
}
{% endschema %}
