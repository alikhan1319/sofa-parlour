{%- comment -%}
  ============================================================
  Questions
  ============================================================

  Heading on the left, questions on the right. Native <details>, so it works
  with no JavaScript at all, is keyboard-operable for free, and a browser's
  find-in-page can open a closed answer to reach a match.

  Every question and answer is the merchant's.
  ============================================================
{%- endcomment -%}

{{ 'sp-blocks.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'question'
-%}

{%- if items.size > 0 -%}
  <section
    class="sp-fq sp-fq--{{ s.scheme }}"
    style="--sp-fq-pad-t: {{ s.padding_top }}px; --sp-fq-pad-b: {{ s.padding_bottom }}px;"
    data-sp-reveal
  >
    <div class="sp-fq__inner">
      <div class="sp-fq__head">
        {%- if s.eyebrow != blank -%}
          <p class="sp-fq__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="sp-fq__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <p class="sp-fq__intro">{{ s.text | escape }}</p>
        {%- endif -%}
        {%- if s.link_label != blank and s.link != blank -%}
          <a class="sp-fq__link" href="{{ s.link }}">
            {{ s.link_label | escape }}
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

      <div class="sp-fq__list">
        {%- for block in items -%}
          <details class="sp-fq__item"{% if forloop.first and s.open_first %} open{% endif %} {{ block.shopify_attributes }}>
            <summary class="sp-fq__q">
              <span>{{ block.settings.question | escape }}</span>
              {%- comment -%}
                One glyph for both states: the plus turns into a cross by
                rotation, so there is no second icon to keep in step.
              {%- endcomment -%}
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="sp-fq__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Questions",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions we are asked" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Talk to us" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first answer", "default": true },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "options": [
        { "value": "ground", "label": "White" },
        { "value": "raised", "label": "Warm off-white" }
      ],
      "default": "raised"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long will my order take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Write your own answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions",
      "blocks": [
        { "type": "question", "settings": { "question": "How long will my order take?", "answer": "<p>Write your own answer here.</p>" } },
        { "type": "question", "settings": { "question": "Can I order a fabric swatch first?", "answer": "<p>Write your own answer here.</p>" } },
        { "type": "question", "settings": { "question": "Will it fit through my door?", "answer": "<p>Write your own answer here.</p>" } }
      ]
    }
  ]
}
{% endschema %}
